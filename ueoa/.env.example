# Local development only. Copy to .env and fill in. In AKS these come from Key Vault (CSI driver / workload identity).
# Never commit .env or put secrets in this template.

# --- Azure OpenAI (used for AI agent generation and workflow planning) ---
AZURE_OPENAI_ENDPOINT=https://secureapi-aoai-north-central-us.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_API_VERSION=2024-10-21
# Set locally in PowerShell; never commit an API key.
AZURE_OPENAI_API_KEY=

# --- Legacy EY foundation gateway settings (not used by this application) ---
UEOA_LLM_URL=
UEOA_LLM_MODEL=
UEOA_LLM_AGENT_ID=
UEOA_LLM_PROJECT_ID=
UEOA_LLM_PROJECT_NAME=
UEOA_LLM_ENVIRONMENT=DEV
# Auth: "foundation key" = password for POST /foundation-api/get_token; the secure route then uses the Bearer token.
# Leave empty to use the unauthenticated generate_response route (not recommended).
UEOA_LLM_FOUNDATION_KEY=

# --- Embeddings: reserved for upcoming knowledge search; not read yet. ---
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Azure AI Search: reserved for upcoming knowledge search; not read yet. ---
AZURE_SEARCH_ENDPOINT=
# Leave empty to use Entra ID (Search Index Data Reader / Contributor roles)
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_PREFIX=ueoa-dev

# --- UEOA runtime (optional overrides) ---
# PostgreSQL persistence. Empty URL keeps the platform entirely in memory.
# Start the local development database with .\scripts\pg-start.ps1.
# UEOA_STORE_URL=postgresql+asyncpg://ueoa:ueoa-dev-only@localhost:5432/ueoa
# UEOA_STORE_ECHO_SQL=false
# UEOA_STORE_POOL_SIZE=5
# Seed pack folder (capabilities/, implementations/, entitlements.yaml). Empty = platform starts with no contracts.
# UEOA_CATALOG_DIR=
# Python package prefixes allowed for binding: local tools (empty = no local tools).
# UEOA_LOCAL_TOOL_PREFIXES=
# Role used when no X-Demo-Role header is sent.
# UEOA_DEFAULT_ROLE=user
# "off" disables the LLM planner (POST /api/v1/plans and goal runs return 503; explicit workflows still run). Empty = on.
UEOA_PLANNER=
# Hosts agents may be registered from (exact or wildcard). For real Copilot Studio agents add e.g.:
#   directline.botframework.com,*.directline.botframework.com,*.api.powerplatform.com
# Entra-auth agents (Microsoft Foundry) need an EXACT host entry, e.g. myresource.services.ai.azure.com (no wildcard).
# UEOA_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma list of Entra token scopes agents may request. Empty = https://ai.azure.com/.default.
UEOA_ENTRA_SCOPES=
# Host headers the API answers to. Empty = localhost,127.0.0.1,testserver,*.localhost.
UEOA_TRUSTED_HOSTS=
# Exact origins (scheme://host:port) allowed on POST/PUT/DELETE and /mcp. Empty = localhost/127.0.0.1 on the API port.
UEOA_ALLOWED_ORIGINS=
# Largest accepted request body in bytes (413 above). Empty = 5000000.
UEOA_MAX_BODY_BYTES=
# true lets the requester approve their own write (demo only). Empty = four-eyes: approver must differ.
UEOA_ALLOW_SELF_APPROVAL=
# --- Secrets referenced by agent cards (secret_ref). Names must start with UEOA_SECRET_. ---
# UEOA_SECRET_<NAME>=

# --- Entra ID for agents with auth scheme `entra` (Microsoft Foundry agents; needs: pip install -e .[azure]) ---
# DefaultAzureCredential runs with require_envvar: AZURE_TOKEN_CREDENTIALS picks the credential, e.g. "dev"
# (Azure CLI / VS Code login), "prod" (workload / managed identity) or "EnvironmentCredential" (the three below).
# The platform identity needs the "Foundry Agent Consumer" role; token scope https://ai.azure.com/.default.
AZURE_TOKEN_CREDENTIALS=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# DEV ONLY: fixed bearer sent instead of an Entra token to loopback agents only (local mocks). Never set in shared envs.
# UEOA_ENTRA_STATIC_TOKEN=
